# Base URL of the API as the browser sees it.
# Development: keep /api (Vite forwards it to the backend, see vite.config.js).
# Production: the public URL of the backend, e.g. https://api.example.com/api
VITE_API_URL=/api

# Development only: where Vite forwards /api requests.
DEV_API_PROXY_TARGET=http://localhost:3000
